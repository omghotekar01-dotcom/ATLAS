{
  "name": "@atlas/api",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.vercel.json",
    "typecheck": "pnpm --filter @atlas/schemas build && pnpm --filter @atlas/core build && pnpm --filter @atlas/chain build && pnpm --filter @atlas/arkiv build && tsc -p tsconfig.test.json && tsc -p tsconfig.vercel.json",
    "test": "vitest run src",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@atlas/arkiv": "workspace:*",
    "@atlas/chain": "workspace:*",
    "@atlas/core": "workspace:*",
    "@atlas/schemas": "workspace:*",
    "@fastify/cors": "^11.4.0",
    "fastify": "^5.6.2",
    "fastify-plugin": "^6.0.1",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "vitest": "latest"
  }
}
