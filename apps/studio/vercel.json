{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter '@atlas/studio...' run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/explorer", "destination": "/index.html" },
    { "source": "/decode", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/transactions", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/status", "destination": "/index.html" }
  ]
}
