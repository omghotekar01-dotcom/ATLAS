# Local configuration. Copy to .env (git-ignored) and never commit it.
# Credentials belong only in your shell or a local .env file.
# The API, importer and Studio load .env automatically; only VITE_* keys reach the browser.

# Arkiv Rabdi reads (required for /v1 function and event data).
ARKIV_ACCESS_KEY=
# Write-only: used by the importer after explicit approval. Never expose to the browser.
ARKIV_PRIVATE_KEY=
# Address whose Arkiv entities ATLAS treats as canonical (the importer wallet).
ATLAS_ARKIV_CREATOR_ADDRESS=

# EVM read-only RPC endpoints. Only configured chains are reported as available.
ATLAS_RPC_URL_1=
ATLAS_RPC_URL_11155111=

# API client configuration.
ATLAS_API_URL=http://localhost:3000
# Used by Studio in the browser. Empty shows the "not connected" state.
VITE_ATLAS_API_URL=http://localhost:3000

# Service limits.
ATLAS_RATE_LIMIT_PER_MINUTE=120
ATLAS_UPSTREAM_TIMEOUT_MS=8000

# Browser origins allowed to call the API (server-side only, never VITE_).
# Dev origins (localhost/127.0.0.1 on ports 5173 and 4173) are allowed by default.
# Comma-separated exact origins, e.g. https://studio.example.com
ATLAS_CORS_ORIGINS=
# Set to false in production to drop the dev origins.
ATLAS_CORS_DEV_ORIGINS=true

# Test gates (one-shot; ignored by the default `pnpm test` run).
# ATLAS_LIVE_RPC=1          # live public-RPC tests, needs ATLAS_RPC_URL_1
# ATLAS_LIVE_ARKIV=1        # live Arkiv read checks, needs ARKIV_ACCESS_KEY + ATLAS_ARKIV_CREATOR_ADDRESS
